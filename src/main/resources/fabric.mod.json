{
	"schemaVersion": 1,
	"id": "skybox-overhaul",
	"version": "${version}",
	"name": "Skybox Overhaul",
	"description": "Colourful, realistic skies that stay vanilla: richer day and night gradients, wide layered sunrises and sunsets, twinkling coloured stars and rare comets.",
	"authors": [
		"Talek"
	],
	"license": "CC0-1.0",
	"icon": "assets/skybox-overhaul/icon.png",
	"environment": "client",
	"mixins": [
		{
			"config": "skybox-overhaul.client.mixins.json",
			"environment": "client"
		}
	],
	"entrypoints": {
		"client": [
			"skybox.overhaul.client.SkyboxOverhaulClient"
		],
		"modmenu": [
			"skybox.overhaul.client.config.SkyboxModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
