{
	"schemaVersion": 1,
	"id": "skybox-overhaul",
	"version": "${version}",
	"name": "Skybox Overhaul",
	"description": "Reimagines the Minecraft sky with a custom nebula and star-filled night skybox. Requires Skyboxify.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/skybox-overhaul/icon.png",
	"environment": "client",
	"mixins": [
		{
			"config": "skybox-overhaul.client.mixins.json",
			"environment": "client"
		}
	],
	"entrypoints": {
		"main": [
			"skybox.overhaul.SkyboxOverhaul"
		],
		"client": [
			"skybox.overhaul.client.SkyboxOverhaulClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"skyboxify": "*"
	}
}
